{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashboard.crosswalknyc.com/api/prometheus/v1/schemas/ask",
  "title": "Prometheus ask response (v1)",
  "type": "object",
  "properties": {
    "schema": {
      "const": "prometheus.ask.v1"
    },
    "kind": {
      "type": "string",
      "enum": [
        "answer",
        "clarify",
        "job",
        "pending",
        "declined"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "conversation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "replayed": {
      "type": "boolean"
    },
    "billing": {
      "type": "object",
      "properties": {
        "charged_usd": {
          "type": "number"
        },
        "balance_after_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "metered"
          ]
        }
      },
      "required": [
        "charged_usd",
        "basis"
      ]
    },
    "answer": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "enum": [
                  "people",
                  "percent",
                  "usd",
                  "index",
                  "ratio",
                  "minutes",
                  "hours",
                  "days"
                ]
              },
              "subject": {
                "type": "string"
              },
              "product": {
                "type": "string"
              },
              "window": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "end": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "as_of": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "base": {
                "type": [
                  "number",
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "label",
              "value",
              "unit"
            ]
          }
        },
        "followups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file_link": {
          "type": "object",
          "description": "The file under a data answer: a direct link good for 7 days, with the file name.",
          "properties": {
            "url": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          },
          "required": [
            "url",
            "name"
          ]
        },
        "files": {
          "type": "array",
          "description": "The same file as API paths under the finished job (GET /api/prometheus/v1/jobs/{id}/files/{name}).",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "url"
            ]
          }
        },
        "table": {
          "type": "object",
          "description": "Present when the answer is a groups by dimensions table assembled in pieces: its size and any piece that did not come back.",
          "properties": {
            "groups": {
              "type": [
                "integer",
                "null"
              ]
            },
            "dimensions": {
              "type": [
                "integer",
                "null"
              ]
            },
            "rows": {
              "type": "integer"
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "text",
        "facts",
        "followups"
      ]
    },
    "clarify": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "send": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "send"
            ]
          }
        }
      },
      "required": [
        "question",
        "options"
      ]
    },
    "job": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "working",
            "starting",
            "done",
            "held",
            "error"
          ]
        },
        "poll": {
          "type": "string"
        },
        "eta_seconds": {
          "type": "integer"
        },
        "stage": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "poll",
        "eta_seconds"
      ]
    },
    "pending": {
      "type": "object",
      "properties": {
        "retry_after_seconds": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        },
        "job_id": {
          "type": "string"
        },
        "poll": {
          "type": "string"
        }
      },
      "required": [
        "retry_after_seconds",
        "text"
      ]
    },
    "declined": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "not_digital",
            "no_base",
            "scope",
            "rate_limit",
            "insufficient_funds",
            "daily_cap",
            "unsupported",
            "unsafe_input",
            "too_large",
            "build_required",
            "unknown_subject",
            "error"
          ]
        },
        "text": {
          "type": "string"
        },
        "retry_after_seconds": {
          "type": "integer"
        },
        "next": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string"
            },
            "endpoint": {
              "type": "string"
            }
          },
          "required": [
            "action"
          ]
        },
        "included": {
          "type": "boolean",
          "description": "Present and true on build_required when the seat's plan includes the build: no price applies."
        },
        "briefs": {
          "type": "array",
          "description": "On build_required: the briefs that were drafted, one row each.",
          "items": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string"
              },
              "decision": {
                "type": "string"
              },
              "window": {
                "type": "string"
              },
              "price_usd": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Null when the seat's plan includes the build or the brief carries no price."
              },
              "included": {
                "type": "boolean"
              },
              "order": {
                "type": "string",
                "description": "The sentence that orders this build through POST /ask."
              },
              "id": {
                "type": "string",
                "description": "Prometheus app only: the id of a brief held for this conversation. Absent when the brief cannot be approved in the app."
              },
              "approve": {
                "type": "string",
                "description": "Prometheus app only: the text that approves this brief through POST /ask in the same conversation."
              },
              "dismiss": {
                "type": "string",
                "description": "Prometheus app only: the text that dismisses this brief."
              },
              "expires_at": {
                "type": "string",
                "description": "Prometheus app only: when the held brief stops being approvable (UTC, 24 hours after it was drafted)."
              },
              "price_label": {
                "type": "string",
                "description": "The price as the seat reads it, with its currency sign."
              }
            },
            "required": [
              "subject",
              "decision"
            ]
          }
        }
      },
      "required": [
        "reason",
        "text"
      ]
    },
    "event": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "brief": {
      "type": "object",
      "description": "Prometheus app only: present on the reply to an approval or a dismissal of a held brief.",
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "started",
            "already_running",
            "already_delivered",
            "dismissed",
            "expired",
            "out_of_date",
            "unknown",
            "open",
            "approving"
          ]
        },
        "closed": {
          "type": "boolean",
          "description": "True when the brief can no longer be approved."
        },
        "subject": {
          "type": "string"
        },
        "included": {
          "type": "boolean"
        },
        "price_usd": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "state",
        "closed"
      ]
    }
  },
  "required": [
    "schema",
    "kind",
    "billing",
    "replayed"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "answer"
          }
        }
      },
      "then": {
        "required": [
          "answer"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "clarify"
          }
        }
      },
      "then": {
        "required": [
          "clarify"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "job"
          }
        }
      },
      "then": {
        "required": [
          "job"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "pending"
          }
        }
      },
      "then": {
        "required": [
          "pending"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "declined"
          }
        }
      },
      "then": {
        "required": [
          "declined"
        ]
      }
    }
  ],
  "additionalProperties": false
}
