# bg-webapp environment file for Hetzner (staging + prod)
# Location on host: /etc/bg-webapp/env
# Owner/mode:       root:root, 0600
#
# THIS FILE IS A TEMPLATE. The real values must be copied from the
# Render "behavioralgraph" service Dashboard > Environment tab
# (dashboard.render.com/web/srv-d5gpci5actks73cr4lig).
#
# CRITICAL: SECRET_KEY must be BYTE-IDENTICAL to Render's live value.
# If it changes, every existing session cookie is invalidated and
# every user is bounced to a 401 on their next request.
#
# Every non-empty line is `KEY=VALUE`. No quoting is required (systemd
# EnvironmentFile passes the value verbatim), but leading/trailing
# whitespace is stripped. Comments start with `#` in column 0.

# -----------------------------------------------------------------------------
# Gunicorn tuning (mirrors what the live Render service runs)
# -----------------------------------------------------------------------------
# The prod Render service runs 3 workers x 4 threads at 600s timeout. We
# mirror that here. Adjust after load testing.
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=600
# Systemd binds gunicorn to 127.0.0.1:8000; nginx reverse-proxies from :80/:443.
PORT=8000

# -----------------------------------------------------------------------------
# Flask session signing key
# -----------------------------------------------------------------------------
# MUST match Render's live value byte-for-byte, else every user is signed out.
# Pull from the "behavioralgraph" service > Environment > SECRET_KEY.
SECRET_KEY=REPLACE_WITH_RENDER_SECRET_KEY

# -----------------------------------------------------------------------------
# Admin login (fallback for local admin bootstrap)
# -----------------------------------------------------------------------------
APP_USERNAME=admin
APP_PASSWORD=REPLACE_WITH_RENDER_APP_PASSWORD

# -----------------------------------------------------------------------------
# ClickHouse - talk to local ClickHouse on this host.
# -----------------------------------------------------------------------------
# 127.0.0.1 is REQUIRED so the eventual :8123 firewall lockdown (ch_firewall
# workstream) does not break the web app.
CH_HOST=127.0.0.1
CH_PORT=8123
CH_USER=bgapp
CH_PASSWORD=REPLACE_WITH_CH_PASSWORD

# -----------------------------------------------------------------------------
# AWS credentials (SES email + S3 dashboard-inputs)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=REPLACE_WITH_RENDER_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_RENDER_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-2
AWS_DEFAULT_REGION=us-east-2

# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=REPLACE_WITH_RENDER_ANTHROPIC_API_KEY
OPENAI_API_KEY=REPLACE_WITH_RENDER_OPENAI_API_KEY
# Optional overrides used by the interpret + analyze + classify paths.
# Leave empty to accept the coded-in defaults.
SYNTH_CHAT_INTERPRET_MODEL=
PROMETHEUS_ANALYZE_MODEL=
PROMETHEUS_CLASSIFY_MODEL=
CLAUDE_REASONING_MODEL=
CLAUDE_EVENT_WINDOW_MODEL=
OPENAI_API_KEY_CONTEXT=

# -----------------------------------------------------------------------------
# Snowflake (still referenced by legacy paths, values from Render dashboard)
# -----------------------------------------------------------------------------
SNOWFLAKE_USER=REPLACE_WITH_RENDER_SNOWFLAKE_USER
SNOWFLAKE_PASSWORD=REPLACE_WITH_RENDER_SNOWFLAKE_PASSWORD
SNOWFLAKE_ACCOUNT=REPLACE_WITH_RENDER_SNOWFLAKE_ACCOUNT
SNOWFLAKE_TOKEN=REPLACE_WITH_RENDER_SNOWFLAKE_TOKEN
SNOWFLAKE_WAREHOUSE=BEHAVIORGRAPH6X
SNOWFLAKE_DATABASE=BEHAVIORALGRAPH
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN

# -----------------------------------------------------------------------------
# Google OAuth (Gmail API)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=REPLACE_WITH_RENDER_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_RENDER_GOOGLE_CLIENT_SECRET

# -----------------------------------------------------------------------------
# SMTP fallback (SES is preferred; SMTP is legacy)
# -----------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no_reply@crosswalknyc.com
SMTP_PASSWORD=REPLACE_WITH_RENDER_SMTP_PASSWORD
FROM_EMAIL=no_reply@crosswalknyc.com

# -----------------------------------------------------------------------------
# Queue + dispatcher URLs (already local on this host)
# -----------------------------------------------------------------------------
SYNTH_QUEUE_URL=http://127.0.0.1:8765
BG_DISPATCH_URL=http://127.0.0.1:7777
BG_DISPATCH_TOKEN=REPLACE_WITH_DISPATCH_TOKEN

# -----------------------------------------------------------------------------
# Cron secret (shared between web + all Hetzner cron units that hit /api/cron/*)
# -----------------------------------------------------------------------------
CRON_SECRET=REPLACE_WITH_RENDER_CRON_SECRET

# -----------------------------------------------------------------------------
# Concurrency + throttles (matches what Render prod runs at)
# -----------------------------------------------------------------------------
BG_PROFILE_QUEUE_WORKERS=2
BG_HEAVY_ANALYSIS_CONCURRENCY=2
BG_CLICKHOUSE_CONCURRENCY=10
BG_JOB_STALE_AFTER_SECONDS=1800
USE_HYBRID_REASONING=true

# -----------------------------------------------------------------------------
# App URLs (set to the eventual public URL at cutover)
# -----------------------------------------------------------------------------
APP_URL=https://behavioralgraph.onrender.com
APP_BASE_URL=https://behavioralgraph.onrender.com
PUBLIC_APP_URL=https://behavioralgraph.onrender.com

# -----------------------------------------------------------------------------
# Push cache secret (dashboard cache invalidator)
# -----------------------------------------------------------------------------
PUSH_CACHE_SECRET=REPLACE_WITH_RENDER_PUSH_CACHE_SECRET

# -----------------------------------------------------------------------------
# GitHub token for admin-side dashboard operations
# -----------------------------------------------------------------------------
GITHUB_TOKEN=REPLACE_WITH_RENDER_GITHUB_TOKEN

# -----------------------------------------------------------------------------
# Microdramas IQ bucket (already used by the scraper cron)
# -----------------------------------------------------------------------------
MICRODRAMAS_IQ_BUCKET=dashboard-inputs

# -----------------------------------------------------------------------------
# Flask
# -----------------------------------------------------------------------------
FLASK_DEBUG=false
