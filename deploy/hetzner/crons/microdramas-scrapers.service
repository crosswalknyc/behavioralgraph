[Unit]
# Daily Microdramas IQ scrape (Peacock + ReelShort + DramaBox + GoodShort +
# NetShort).
#
# Migrated from Render cron `microdramas-scrapers-cron` (crn-d9kebinavr4c73aqtfag).
# Runs the scrapers directly on this box - no HTTP round-trip through the
# web service. Writes fresh snapshots to:
#   s3://dashboard-inputs/microdramas_iq/snapshots/latest/
#   s3://dashboard-inputs/microdramas_iq/snapshots/{YYYY-MM-DD}/
# and merges them into microdramas_iq/catalog.json.
#
# Each per-source fetch() has a curated baseline fallback so the catalog
# date always advances even when datacenter egress is challenged.

Description=Daily Microdramas IQ scrape (Peacock, ReelShort, DramaBox, GoodShort, NetShort, DramaShorts, aTwist)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
# Live checkout on this box - kept in sync via `rsync` and manual
# pushes, mirrors the paths already used by the trends_scrapers cron
# in root's crontab. The stale /opt/bg-webapp copy from an earlier
# migration attempt is not used and never should be.
WorkingDirectory=/root/finished_codes/bg-webapp
# AWS creds + region from the same env file every Hetzner-side script
# reads (SES + S3 dashboard-inputs). Falls back to /root/.aws for
# boto3 credential discovery when the file is absent.
EnvironmentFile=-/etc/bg-webapp/env
EnvironmentFile=-/root/finished_codes/.env.trends_scrapers
# 30-minute timeout; the scrapers themselves finish in ~5-10 min but
# individual fetch retries can extend the window.
TimeoutStartSec=1800
ExecStart=/usr/bin/python3 -m scripts.microdramas_scrapers.run_all
StandardOutput=append:/var/log/microdramas-scrapers.log
StandardError=append:/var/log/microdramas-scrapers.log

[Install]
WantedBy=multi-user.target
