  "gradient": {
    "_note": "Angles are in pixel space, measured clockwise from left-to-right, as make_gradients.py draws them. Page gradients are baked into the slide or page background as an image. Build every gradient at full resolution and dithered (make_gradients.py; cw_deck.js does it for deck pages); assets/gradients holds previews only.",
    "signal": {
      "stops": [
        "#C7F23E",
        "#E8F3CC"
      ],
      "angle": 47,
      "use": "Default alternative page. Signal Green at the top left fading to a pale green-white at the bottom right. Ad Attribution v5 p7, Unlikely Collaborators p8, Deck System templates 01 and 24."
    },
    "orchid": {
      "stops": [
        "#E682FF",
        "#F4E4F5"
      ],
      "angle": 47,
      "use": "Orchid statement page, same fade. Unlikely Collaborators p5."
    },
    "signalDeep": {
      "stops": [
        "#C7F23E",
        "#9FD628"
      ],
      "angle": -25,
      "use": "Saturated variant, Signal Green at the bottom left deepening to the top right. Slow Horses v10 p2. Use when dark text and cards need a stronger ground; one per deck at most."
    },
    "offWhiteEdge": {
      "stops": [
        [
          0.0,
          "#EAE8E2"
        ],
        [
          0.65,
          "#EAE8E2"
        ],
        [
          0.91,
          "#D6EE84"
        ],
        [
          1.0,
          "#C7F33D"
        ]
      ],
      "angle": 30,
      "use": "Off-White page with Signal Green rising from the right edge. Ad Attribution v5 p5. Counts as the deck's alternative page."
    },
    "glowCard": {
      "stops": [
        [
          0.0,
          "#2B3F2D"
        ],
        [
          0.42,
          "#15252A"
        ],
        [
          0.73,
          "#0B1617"
        ],
        [
          0.99,
          "#020505"
        ]
      ],
      "angle": 120,
      "use": "Dark card with a faint green glow at the top left. Step and process cards on Off-White or Graphite. Unlikely Collaborators p6."
    },
    "graphiteWash": {
      "stops": [
        "#0C1F1F",
        "#111E1F"
      ],
      "angle": 42,
      "use": "Dark ground of template covers 3 and 6. Not laid over photographs: a photo keeps its true color, with a shadow only under the copy (bake_photo.py)."
    },
    "tealScrim": {
      "color": "#0C1618",
      "opacityFrom": 0.9,
      "opacityTo": 0.6,
      "angle": 115,
      "radiusIn": 0.28,
      "use": "Rounded readability panel behind type on a busy photograph, only where the words are."
    },
    "orchidDeep": {
      "stops": [
        "#9E45C4",
        "#ED9BFE"
      ],
      "direction": "bottom left to top right",
      "use": "Deep Orchid statement page (Texas Rangers, Oct 2026, p29): first line Graphite Bold, the second Off-White Bold, body #3B1C46. Approved alongside the pale Orchid fade; one per deck at most, for a statement, never for data.",
      "angle": -29
    },
    "photoTone": {
      "dark": "#081113",
      "light": "#E9E8E1",
      "darkType": "#FFFFFF",
      "lightType": "#0C1618",
      "example": "NFL Melbourne cover, top to bottom: 0.97 at 0, 0.38 at 0.45, 0.02 at 0.55, 0.72 at 0.65, 0.78 at 0.9, 0.98 at 1.0",
      "use": "Long multi-stop gradient over a photograph: deepest at the edges and behind the copy, clearest over the subject, smooth joins. Deep Ink with white type on dark photos, Off-White with Graphite type on light ones. Baked into the image (bake_photo.py). An even screen-back only for texture pages."
    }
  },
